generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  CREATED
  ACTIVE
}

enum ActivityStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ActivityType {
  TRAINING
  EMPLOYMENT
  TRAINING_COURSE
}

enum ActivityUserStatusEnum {
  ACTIVE
  HOLIDAY
  RELEASED
  SICK
}

enum ActivityUserAvailabilityEnum {
  MORNING
  EVENING
  ALL_DAY
  UNAVAILABLE
}

enum SchedulingApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
}

model Company {
  id     String        @id @default(uuid()) @db.Uuid
  name   String
  status CompanyStatus @default(CREATED)

  ownerUserId String? @unique @db.Uuid

  ownerUser User? @relation("CompanyOwner", fields: [ownerUserId], references: [id])

  users          User[]
  units          Unit[]
  roles          Role[]
  qualifications Qualification[]
  activities     Activity[]
  activations    Activation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id String @id @default(uuid()) @db.Uuid

  companyId String @db.Uuid

  name      String
  type      ActivityType
  startDate DateTime
  endDate   DateTime
  status    ActivityStatus @default(DRAFT)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  activityTasks        ActivityTask[]
  schedulingDays       ActivitySchedulingDay[]
  activityUserStatuses ActivityUserStatus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model ActivitySchedulingDay {
  id String @id @default(uuid()) @db.Uuid

  activityId String @db.Uuid
  date       DateTime

  openedAt       DateTime @default(now())
  openedByUserId String?  @db.Uuid
  approvalStatus SchedulingApprovalStatus @default(DRAFT)

  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  openedByUser User?    @relation("ActivitySchedulingDayOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activityId, date])
  @@index([activityId])
}

model ActivityTask {
  id String @id @default(uuid()) @db.Uuid

  activityId String @db.Uuid

  name        String
  description String?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  taskInstances               TaskInstance[]
  manpowerRequirements        ActivityTaskManpowerRequirement[]
  roleRequirements            ActivityTaskRoleRequirement[]
  qualificationRequirements   ActivityTaskQualificationRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityId])
}

model TaskInstance {
  id String @id @default(uuid()) @db.Uuid

  activityTaskId String @db.Uuid

  title     String
  startTime DateTime
  endTime   DateTime

  activityTask ActivityTask @relation(fields: [activityTaskId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityTaskId])
}

model Assignment {
  id String @id @default(uuid()) @db.Uuid

  taskInstanceId String @db.Uuid
  userId         String @db.Uuid
  createdBy      String? @db.Uuid

  taskInstance TaskInstance @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  user         User         @relation("AssignmentAssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("AssignmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskInstanceId, userId])
  @@index([taskInstanceId])
  @@index([userId])
  @@index([createdBy])
}

model ActivityTaskManpowerRequirement {
  id String @id @default(uuid()) @db.Uuid

  activityTaskId String @db.Uuid

  required Boolean @default(true)
  quantity Int     @default(1)

  activityTask ActivityTask @relation(fields: [activityTaskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activityTaskId])
  @@index([activityTaskId])
}

model ActivityTaskRoleRequirement {
  id String @id @default(uuid()) @db.Uuid

  activityTaskId String @db.Uuid
  roleId         String @db.Uuid

  required Boolean @default(true)
  quantity Int     @default(1)

  activityTask ActivityTask @relation(fields: [activityTaskId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activityTaskId, roleId])
  @@index([activityTaskId])
  @@index([roleId])
}

model ActivityTaskQualificationRequirement {
  id String @id @default(uuid()) @db.Uuid

  activityTaskId   String @db.Uuid
  qualificationId  String @db.Uuid

  required Boolean @default(true)
  quantity Int     @default(1)

  activityTask ActivityTask @relation(fields: [activityTaskId], references: [id], onDelete: Cascade)
  qualification Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activityTaskId, qualificationId])
  @@index([activityTaskId])
  @@index([qualificationId])
}

model User {
  id String @id @default(uuid()) @db.Uuid

  companyId String @db.Uuid
  unitId    String @db.Uuid

  firstName      String
  lastName       String
  phone          String
  email          String?
  personalNumber String
  googleSubject  String?   @unique

  lastLoginAt DateTime?
  activatedAt     DateTime?
  phoneVerifiedAt DateTime?
  googleLinkedAt  DateTime?
  isActive        Boolean   @default(true)

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation("UserUnit", fields: [unitId], references: [id])

  ownedCompany Company? @relation("CompanyOwner")

  createdActivations Activation[] @relation("ActivationCreatedByUser")
  activations        Activation[] @relation("ActivationTargetUser")

  userRoles            UserRole[]
  userQualifications   UserQualification[]
  userPermissions      UserPermission[]
  activityUserStatuses ActivityUserStatus[]
  openedSchedulingDays ActivitySchedulingDay[] @relation("ActivitySchedulingDayOpenedBy")
  assignments          Assignment[]          @relation("AssignmentAssignedUser")
  assignmentsCreated   Assignment[]          @relation("AssignmentCreatedBy")

  createdUnits          Unit[]          @relation("UnitCreatedBy")
  createdRoles          Role[]          @relation("RoleCreatedBy")
  createdQualifications Qualification[] @relation("QualificationCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone])
  @@unique([companyId, personalNumber])
  @@index([companyId])
  @@index([unitId])
}

model Activation {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  createdByUserId String   @db.Uuid
  companyId       String   @db.Uuid
  tokenHash       String   @unique
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User                    @relation("ActivationTargetUser", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User                    @relation("ActivationCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  otpChallenges ActivationOtpChallenge[]

  @@index([userId])
  @@index([createdByUserId])
  @@index([companyId])
  @@index([expiresAt])
}

model ActivationOtpChallenge {
  id            String   @id @default(uuid()) @db.Uuid
  activationId  String   @db.Uuid
  codeHash      String
  expiresAt     DateTime
  usedAt        DateTime?
  attemptCount  Int      @default(0)
  maxAttempts   Int
  lockedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activation Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@index([activationId])
  @@index([expiresAt])
}

model Unit {
  id String @id @default(uuid()) @db.Uuid

  companyId String @db.Uuid

  name         String
  description  String?
  displayOrder Int     @default(0)

  createdBy String? @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  users User[] @relation("UserUnit")

  createdByUser User? @relation("UnitCreatedBy", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  companyId String @db.Uuid

  name        String
  description String?

  createdBy String? @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  createdByUser User? @relation("RoleCreatedBy", fields: [createdBy], references: [id])

  userRoles UserRole[]
  activityTaskRoleRequirements ActivityTaskRoleRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Qualification {
  id String @id @default(uuid()) @db.Uuid

  companyId String @db.Uuid

  name        String
  description String?

  createdBy String? @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  createdByUser User? @relation("QualificationCreatedBy", fields: [createdBy], references: [id])

  userQualifications UserQualification[]
  activityTaskQualificationRequirements ActivityTaskQualificationRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id String @id @default(uuid()) @db.Uuid

  key         String  @unique
  description String?

  userPermissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

model UserQualification {
  userId          String @db.Uuid
  qualificationId String @db.Uuid

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, qualificationId])
}

model UserPermission {
  userId       String @db.Uuid
  permissionId String @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, permissionId])
}

model SystemUser {
  id String @id @default(uuid()) @db.Uuid

  email     String @unique
  firstName String
  lastName  String

  isActive Boolean @default(true)

  permissions SystemUserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemPermission {
  id String @id @default(uuid()) @db.Uuid

  key         String  @unique
  description String?

  users SystemUserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemUserPermission {
  systemUserId       String @db.Uuid
  systemPermissionId String @db.Uuid

  systemUser       SystemUser       @relation(fields: [systemUserId], references: [id], onDelete: Cascade)
  systemPermission SystemPermission @relation(fields: [systemPermissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([systemUserId, systemPermissionId])
}

model ActivityUserStatus {
  id String @id @default(uuid()) @db.Uuid

  activityId String @db.Uuid
  userId     String @db.Uuid
  date       DateTime
  status     ActivityUserStatusEnum
  availability ActivityUserAvailabilityEnum @default(ALL_DAY)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activityId, userId, date])
  @@index([activityId])
  @@index([userId])
  @@index([date])
}
