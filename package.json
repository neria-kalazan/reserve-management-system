{
  "name": "reserve-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "pnpm --filter backend test",
    "test:cov": "pnpm --filter backend test:cov",
    "build": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "start": "pnpm --filter backend start",
    "start:dev": "bash -c 'trap \"kill 0\" INT TERM EXIT; pnpm --filter backend start:dev & pnpm --filter frontend dev & wait'",
    "dev": "pnpm --filter backend start:dev",
    "dev:frontend": "pnpm --filter frontend dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.20.0"
}